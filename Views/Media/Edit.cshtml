@model MediaLibraryApp.Models.MediaViewModel

@{
    ViewData["Title"] = "Upravit položku";
}

<div class="card shadow-sm max-w-md mx-auto mt-4" style="max-width: 600px;">
    <div class="card-header bg-warning">
        <h3 class="mb-0">Upravit položku: @Model.Title</h3>
    </div>
    <div class="card-body">
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="MediaType" /> 

            <div class="mb-3">
                <label class="form-label fw-bold">Typ média (nelze změnit)</label>
                <input class="form-control bg-light" value="@Model.MediaType" readonly disabled />
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-bold">Název</label>
                <input asp-for="Title" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold">Popis</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>

            <hr />

            @if (Model.MediaType == "Book")
            {
                <div class="mb-3">
                    <label asp-for="Author" class="form-label text-primary fw-bold">Autor knihy</label>
                    <input asp-for="Author" class="form-control" />
                </div>
            }
            @if (Model.MediaType == "CD")
            {
                <div class="mb-3">
                    <label asp-for="Artist" class="form-label text-success fw-bold">Interpret</label>
                    <input asp-for="Artist" class="form-control" />
                </div>
            }
            @if (Model.MediaType == "DVD")
            {
                <div class="mb-3">
                    <label asp-for="Director" class="form-label text-danger fw-bold">Režisér</label>
                    <input asp-for="Director" class="form-control" />
                </div>
            }

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Zrušit</a>
                <button type="submit" class="btn btn-warning fw-bold">Uložit změny</button>
            </div>
        </form>
    </div>
</div>