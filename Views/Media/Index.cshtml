@model IEnumerable<MediaLibraryApp.Models.MediaItem>

@{
    ViewData["Title"] = "Moje Sbírka";
}

<style>
    th {
        resize: horizontal;
        overflow: auto;
        min-width: 80px; 
    }
    
    .desc-truncate {
        max-width: 200px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        cursor: help; 
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Moje Sbírka Médií</h1>
    <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm">+ Přidat novou položku</a>
</div>

<div class="table-responsive bg-white p-3 rounded shadow-sm">
    <table class="table table-striped table-hover align-middle" id="mediaTable">
        <thead class="table-dark">
            <tr>
                <th>Název</th>
                <th>Typ</th>
                <th>Tvůrce</th>
                <th>Popis</th>
                <th>Pořízeno</th>
                <th>Stav</th>
                <th style="resize: none;">Akce</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td class="fw-bold">@item.Title</td>
                    
                    <td><span class="badge bg-secondary">@item.GetType().Name</span></td>
                    
                    <td>
                        @if (item is MediaLibraryApp.Models.Book book) {
                            <span>📚 @book.Author</span>
                        } else if (item is MediaLibraryApp.Models.CD cd) {
                            <span>🎵 @cd.Artist</span>
                        } else if (item is MediaLibraryApp.Models.DVD dvd) {
                            <span>🎬 @dvd.Director</span>
                        }
                    </td>
                    
                    <td class="desc-truncate" title="@item.Description">
                        @(string.IsNullOrEmpty(item.Description) ? "—" : item.Description)
                    </td>
                    
                    <td>@item.DateAcquired.ToShortDateString()</td>
                    
                    <td>
                        @if (item.IsBorrowed) {
                            <span class="badge bg-danger">Půjčeno: @item.BorrowedBy</span>
                        } else {
                            <span class="badge bg-success">Doma</span>
                        }
                    </td>
                    
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">✏️ Upravit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">🗑️ Smazat</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Count() == 0)
{
    <div class="alert alert-info text-center mt-4 shadow-sm fw-bold">
        Zatím tu nic není. Klikni na "Přidat novou položku" a začni budovat svou sbírku!
    </div>
}


@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    
    <script>
        $(document).ready(function() {
            $('#mediaTable').DataTable({
                
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/cs.json"
                },
                
                "columnDefs": [
                    { "orderable": false, "targets": 6 }
                ],
                "order": [[ 4, "desc" ]]
            });
        });
    </script>
}
